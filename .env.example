# ====================================================================
# CollegeCentre 2.0 - Production Environment Variables Template
# ====================================================================
# Copy this file to .env.local for local development.
# For production hosting (Vercel, Railway, Fly.io, Supabase), configure
# these environment variables in your deployment dashboard.

# --------------------------------------------------------------------
# 1. Supabase Public Client Credentials (Safe to expose to browser)
# --------------------------------------------------------------------
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public anonymous API key (enforces RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --------------------------------------------------------------------
# 2. Supabase Server Secret (NEVER expose to browser client)
# --------------------------------------------------------------------
# Service role key used only for administrative jobs or trusted webhooks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --------------------------------------------------------------------
# 3. Application Domain & Canonical URL
# --------------------------------------------------------------------
# Base URL for dynamic sitemaps, robots.txt, Open Graph cards, and OAuth redirects
# Production: https://collegecentre.in
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://collegecentre.in

# --------------------------------------------------------------------
# 4. Optional: Secrets for Background Jobs or Health Check Auth
# --------------------------------------------------------------------
# Secret token to protect internal cron or maintenance tasks
CRON_SECRET=generate-a-secure-random-32-byte-hex-string
